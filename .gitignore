# ────────────────────────────────────────────────────────────
# 依赖
# ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ────────────────────────────────────────────────────────────
# 构建产物
# ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ────────────────────────────────────────────────────────────
# 日志
# ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ────────────────────────────────────────────────────────────
# 编辑器 / IDE 配置（开发软件配置目录，按豆哥规则不上传）
# ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ────────────────────────────────────────────────────────────
# 操作系统生成文件
# ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ────────────────────────────────────────────────────────────
# 环境变量 / 密钥（私密信息绝不入库）
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ────────────────────────────────────────────────────────────
# 缓存 / 临时
# ────────────────────────────────────────────────────────────
.cache/
.temp/
.tmp/
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.vite/

# ────────────────────────────────────────────────────────────
# 测试 / 覆盖率
# ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ────────────────────────────────────────────────────────────
# 第三方平台部署配置（部署目标/Token 属私密）
# ────────────────────────────────────────────────────────────
.vercel/
.netlify/
.firebase/
.surgeignore

# 开发期临时验证脚本与截图
scripts/_shots/
scripts/screenshot.mjs
scripts/debug*.mjs

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
secrets*
credentials*
*.token
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude/
.claude.json
.codex/
.cursor/
.gemini/
.zcode/
.windsurf/
.trae/
.roo/
.aider*
continue/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
notes/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Python 运行产物 ──
__pycache__/
*.py[cod]
.venv/
venv/


# ── Node 前端产物 ──
.next/
.nuxt/


# ── 系统与临时文件 ──
*.tmp
